# The hostname Caddy serves (HTTPS with an automatic certificate, and plain HTTP). Production: origin.orbitar.media
SERVER_DOMAIN=orbitar.media.local

# Autorization header that protects all POST requests
CLIENT_ID=

# pictshare data mount
DATA_DIR=/var/lib/orbitar_media_data

# AES key for generating hashes with encoded dimensions
HASH_DIMS_AES_KEY=

# S3 backup settings
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Which server gets the traffic: php (PictShare) or go (the rewrite in mediaserver/). Both always run.
BACKEND=php

# Optional max upload size in MB, default is 50MB
#MAX_UPLOAD_SIZE=50

# Optional resource limits (defaults in docker-compose.yml). The deploy workflow requires the same uncommented keys
# here and in the host's .env, so to set one in production, uncomment it here and add it there in the same change.
# PHP memory per request in MB
#PHP_MEMORY_LIMIT=256
# Parallel ffmpeg runs (upload remux, background transcodes, gif->mp4)
#MAX_CONCURRENT_VIDEO_HANDLERS=2
# Address-space cap per ffmpeg/ffprobe process in MB
#FFMPEG_MEMORY_LIMIT_MB=2560

# Optional Coub API proxy URL (to bypass IP blocks)
# When set, coub requests go through this proxy instead of directly to coub.com
COUB_PROXY_URL=